# Copy to .env on the server:  cp .env.example .env  &&  chmod 600 .env
# Never commit .env. Real credentials do not belong in code, README or Git.

# ---------- RingCentral ----------
# Production API base URL.
RC_SERVER_URL=https://platform.ringcentral.com
# From the RingCentral Developer Console -> your app -> Credentials (production).
RC_CLIENT_ID=your-ringcentral-client-id
RC_CLIENT_SECRET=your-ringcentral-client-secret
# JWT credential of the admin user the bot acts as (Developer Console -> Credentials -> JWT).
RC_JWT=your-ringcentral-jwt-credential

# ---------- Google Sheets ----------
# Absolute path (or path relative to the project folder) of the service account JSON key.
# Keep it outside Git, e.g. /opt/rc-hr-daily-report/secrets/google-service-account.json, chmod 600.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
# Alternative to the key file (do not set both): the service account e-mail and the
# private key from the JSON key, in one line with "\n" escapes, in double quotes.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The ID part of https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SPREADSHEET_ID=your-google-spreadsheet-id
# Tab name. Created automatically if it does not exist.
GOOGLE_SHEET_NAME=RING CENTRAL

# ---------- Report ----------
# IANA timezone for day boundaries and schedules (DST handled automatically).
REPORT_TIMEZONE=America/Chicago
# Global first report date (YYYY-MM-DD). Each HR additionally has its own reportStartDate;
# the later of the two applies. Missed days since then are back-filled automatically.
REPORT_START_DATE=2026-10-01
# How many completed days BEFORE yesterday are re-checked by the daily 00:00 run.
RECONCILE_DAYS=3
# Path to the HR list.
HR_CONFIG_PATH=./hr.config.json

# ---------- State / logs ----------
# SQLite state DB (created automatically). Must be on persistent storage.
STATE_DB_PATH=./data/state.sqlite
# debug | info | warn | error
LOG_LEVEL=info

# ---------- Optional tuning (defaults shown) ----------
# Schedules (5-field cron, evaluated in REPORT_TIMEZONE).
# MAIN_CRON=0 0 * * *
# LATE_RECHECK_CRON=15 0 * * *
# RETRY_CRON=30 * * * *
# Run the catch-up of missing/failed days when the process starts.
# CATCH_UP_ON_START=true
# How long a scheduled run waits for the lock held by a manual CLI run (ms).
# LOCK_WAIT_MS=1800000
# What to do with an inbound call whose result value has no mapping:
#   fail             -> do not write that HR/day, log diagnostics, retry later (default)
#   count-not-missed -> count it as inbound but not missed, log a warning
# UNKNOWN_CALL_RESULT_POLICY=fail
# Minutes fetched before/after the day to see all legs of calls crossing midnight.
# CALL_LOG_BUFFER_MINUTES=120
# Include call-log records the user deleted in the app (they were real calls).
# RC_INCLUDE_DELETED_CALLS=true
# RC_CALL_LOG_PAGE_SIZE=1000
# RC_MESSAGE_PAGE_SIZE=250
# RC_MAX_CONCURRENCY=2
# RC_MAX_RETRIES=5
# RC_REQUEST_TIMEOUT_MS=60000
# HR_CONCURRENCY=2
# GOOGLE_REQUEST_TIMEOUT_MS=60000
# SHEETS_BATCH_SIZE=200
