{
  "name": "rc-hr-daily-report",
  "version": "1.0.0",
  "description": "Collects daily RingCentral call and SMS statistics for HR extensions and upserts them into Google Sheets. Runs under PM2.",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "node src/cli/check.js",
    "list-extensions": "node src/cli/list-extensions.js",
    "report": "node src/cli/report.js",
    "status": "node src/cli/status.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\""
  },
  "dependencies": {
    "@googleapis/sheets": "^18.1.1",
    "@ringcentral/sdk": "^5.0.11",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.7",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0"
  }
}
